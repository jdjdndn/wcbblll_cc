          "file": "wrangler.jsonc",
          "pattern": "\"404-page\""
        }
      ],
      "deploy": [
        "cd E:\\code\\aaa-sites\\github.io && git add dist && git commit -m \"build\" && git push",
        "cd E:\\code\\aaa-sites\\github.io && npm run cf:build && npm run cf:deploy"
      ],
      "rebuild": true,
      "regenIsBuild": true,
      "prechecks": [
        {
          "desc": "wrangler已配404(404-page)",
          "type": "contains",
          "file": "wrangler.jsonc",
          "pattern": "\"404-page\""
