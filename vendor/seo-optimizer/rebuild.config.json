{
  "sitesRoot": "E:\\code\\aaa-sites",
  "sites": [
    {
      "name": "wcbblll_cc",
      "dir": "E:\\code\\aaa-sites\\wcbblll_cc",
      "build": [
        "node",
        [
          "build-static.mjs"
        ]
      ],
      "verify": [
        {
          "desc": "链接数据全量静态化进HTML",
          "type": "data-vs-html",
          "file": "index.html",
          "pattern": {
            "dataFile": "links-data.json",
            "dataPath": "links",
            "htmlPattern": "class=\"link-card\""
          }
        },
        {
          "desc": "核心内容不再依赖fetch",
          "type": "not-contains",
          "file": "index.html",
          "pattern": "fetch('links-data.json')"
        },
        {
          "desc": "sitemap与页面产物双向一致",
          "type": "sitemap",
          "file": "sitemap.xml",
          "pattern": {
            "domain": "https://wcbblll.cc",
            "pageFiles": [
              "index.html",
              "category/*.html"
            ]
          }
        },
        {
          "desc": "页面Meta完整(title/desc/canonical/OG/JSON-LD)",
          "type": "page-quality",
          "file": "index.html",
          "pattern": {
            "pages": [
              "index.html",
              "category/*.html"
            ],
            "canonical": "https://wcbblll.cc",
            "og": [
              "og:title",
              "og:description",
              "og:image",
              "og:url"
            ],
            "jsonld": true
          }
        },
        {
          "desc": "站内链接无死链+图片alt齐全",
          "type": "link-health",
          "file": "index.html",
          "pattern": {
            "pages": [
              "index.html",
              "category/*.html"
            ]
          }
        },
        {
          "desc": "分类页已生成",
          "type": "count-files",
          "file": "category",
          "pattern": ".html",
          "min": 12
        },
        {
          "desc": "wrangler已配404(404-page)",
          "type": "contains",
          "file": "wrangler.jsonc",
          "pattern": "\"404-page\""
        },
        {
          "desc": "移动端适配(viewport)",
          "type": "mobile-friendly",
          "file": "index.html",
          "pattern": {
            "pages": [
              "index.html",
              "category/*.html"
            ]
          }
        },
        {
          "desc": "结构化数据深度校验",
          "type": "structured-data",
          "file": "index.html",
          "pattern": {
            "pages": [
              "index.html",
              "category/*.html"
            ]
          }
        },
        {
          "desc": "Core Web Vitals(CLS/阻塞script)",
          "type": "core-web-vitals",
          "file": "index.html",
          "pattern": {
            "pages": [
              "index.html",
              "category/*.html"
            ]
          }
        }
      ],
      "deploy": [
        "cd E:\\code\\aaa-sites\\wcbblll_cc && npx wrangler deploy"
      ],
      "rebuild": true,
      "regen": [
        "node",
        [
          "build-static.mjs"
        ]
      ],
      "smoke": [
        {
          "url": "https://wcbblll.cc/",
          "status": 200,
          "contains": "link-card"
        },
        {
          "url": "https://wcbblll.cc/category/ecommerce.html",
          "status": 200,
          "contains": "link-card"
        },
        {
          "url": "https://wcbblll.cc/sitemap.xml",
          "status": 200,
          "contains": "<loc>"
        },
        {
          "url": "https://wcbblll.cc/robots.txt",
          "status": 200
        },
        {
          "url": "https://wcbblll.cc/__smoke_missing__.html",
          "status": 404
        }
      ],
      "onlineBase": "https://wcbblll.cc"
    },
    {
      "name": "github.io",
      "dir": "E:\\code\\aaa-sites\\github.io",
      "sourceMap": {
